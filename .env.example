# pnpm dev needs no environment file: it starts an isolated local database.
# Never put real personal information in the local development store.
# For dev:remote, copy to .env.local and use only dedicated non-production resources.
ORAN_ENV=development
ORAN_DATABASE_HOST=
DATABASE_URL=
ORAN_APP_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Never set ORAN_LOCAL_DEV or ORAN_SESSION_SECRET in hosted environments.
