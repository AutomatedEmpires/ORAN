{
  "name": "oran",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.22.2 <25",
    "pnpm": "10.34.9"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev:remote": "node --env-file-if-exists=.env.local node_modules/next/dist/bin/next dev --hostname 127.0.0.1",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:types": "tsx scripts/types.ts",
    "db:types:check": "tsx scripts/types.ts --verify",
    "admin:grant": "node --env-file-if-exists=.env.local --import tsx scripts/grant-admin.ts",
    "test:integration": "vitest run tests/catalog.test.ts tests/migrations.test.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.23",
    "kysely": "0.29.8",
    "next": "16.4.4",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.14",
    "@electric-sql/pglite-postgis": "0.2.14",
    "@electric-sql/pglite-socket": "0.2.17",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "kysely-codegen": "0.20.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
