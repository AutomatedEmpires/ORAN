    "@electric-sql/pglite-postgis": "0.2.14",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "kysely-codegen": "0.20.0",
    "tsx": "4.23.15",
