new file mode 100644
index 0000000..ca6459c
--- /dev/null
+++ b/src/ui/button-control.tsx
@@ -0,0 +1,23 @@
+'use client';
+
+type ControlProps = Omit<React.ComponentPropsWithRef<'button'>, 'disabled'> & { disabled?: boolean; busy?: boolean };
+
+// DESIGN_SYSTEM.md §5.4: a disabled or busy button stays focusable, so it never gets the native `disabled` attribute.
+// It says so with aria-disabled and refuses the click instead. preventDefault also stops the submit that Enter, Space
+// and a form's implicit submission each raise as a click on the button. The guard needs React, so a click before the page
+// has hydrated still reaches the browser's own behavior. The label (children) is the caller's and never changes.
+// This is the only client code of the Button; src/ui/button.tsx wraps it so that server components can use the class names.
+export function ButtonControl({ disabled, busy, onClick, 'aria-disabled': ariaDisabled, 'aria-busy': ariaBusy, ...props }: ControlProps): React.JSX.Element {
+  const inactive = Boolean(disabled || busy);
+  return (
+    <button
+      {...props}
+      aria-disabled={inactive ? true : ariaDisabled}
+      aria-busy={busy ? true : ariaBusy}
+      onClick={(event) => {
+        if (inactive) event.preventDefault();
+        else onClick?.(event);
+      }}
+    />
+  );
+}
diff --git a/src/ui/button.tsx b/src/ui/button.tsx
new file mode 100644
index 0000000..dd18744
--- /dev/null
+++ b/src/ui/button.tsx
@@ -0,0 +1,17 @@
+import { ButtonControl } from './button-control';
+
+export type ButtonVariant = 'primary' | 'secondary' | 'quiet' | 'destructive' | 'destructive-confirm';
+export type ButtonSize = 'default' | 'large' | 'compact';
+
+// Primary and the default size are the base look and add no class of their own. Links that look like buttons use this too.
+// This module has no 'use client' on purpose: a server component may call buttonClassName(), which a client module's
+// exports do not allow. Only the click guard needs the browser, and it lives in button-control.tsx.
+export function buttonClassName(variant: ButtonVariant = 'primary', size: ButtonSize = 'default'): string {
+  return ['button', variant === 'primary' ? '' : 'button-' + variant, size === 'default' ? '' : 'button-' + size].filter(Boolean).join(' ');
+}
+
+export type ButtonProps = Omit<React.ComponentPropsWithRef<'button'>, 'className' | 'disabled'> & { variant?: ButtonVariant; size?: ButtonSize; disabled?: boolean; busy?: boolean };
+
+export function Button({ variant, size, ...props }: ButtonProps): React.JSX.Element {
+  return <ButtonControl {...props} className={buttonClassName(variant, size)} />;
+}
